load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "bd3_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "bd3_e2e_benchmark")

bd3_rust_crate(
    name = "cli",
    crate_name = "bd3_cli",
    extra_binaries = [
        "//bd3-rs/bwrap:bwrap",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS,
    test_data_extra = glob(["src/**/snapshots/**"]),
)

multiplatform_binaries(
    name = "3bd",
)

bd3_e2e_benchmark(
    name = "bd3-help",
    binaries = [":3bd"],
)
